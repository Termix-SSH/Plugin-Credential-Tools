{
  "id": "credential-tools",
  "name": "Credential Tools",
  "version": "1.1.0",
  "description": "Generate SSH keys, check them and copy a public key to a host.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Credential-Tools",
  "docs": "https://docs.termix.site/plugins/credential-tools",
  "video": "https://www.youtube.com/watch?v=apuCWgyrsvk",
  "category": "Access & Security",
  "icon": "KeyRound",
  "features": [
    "Generate Ed25519, RSA and ECDSA key pairs",
    "Detect a key's type and get the public key from a private key",
    "Check that a public and private key match",
    "Copy a saved public key to a host's authorized keys"
  ],
  "env": [],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.5"
  },
  "capabilities": [
    "network:serve",
    "hosts:read",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "ui:surface",
    "operations:provide"
  ],
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "contributes": {
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["user"]
      }
    ],
    "http": {
      "legacyRedirects": [
        {
          "from": "/credentials",
          "to": "/credentials"
        }
      ]
    },
    "operations": {
      "actions": [
        {
          "id": "credential-tools.list-keys",
          "titleKey": "operations.list.title",
          "scope": "server",
          "risk": "read",
          "permission": "use",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "credential-tools.deploy-key",
          "titleKey": "operations.deploy.title",
          "icon": "KeyRound",
          "scope": "host",
          "risk": "change",
          "permission": "use",
          "hostAccess": "manage",
          "dryRun": "describe",
          "idempotent": true,
          "inputs": [
            {
              "key": "key",
              "type": "string",
              "labelKey": "operations.key",
              "required": true,
              "optionsFrom": "credential-tools.list-keys"
            }
          ]
        }
      ]
    }
  }
}
